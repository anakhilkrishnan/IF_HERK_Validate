# Scalar partner of inputs_vector_burgers_q1d (identical grid, nu, T, dt sweep).
# ic.stagger = 1 0 0 samples phi at the x-face points where the vector run
# stores u, so the two can be compared index by index. On its own this is
# also the quasi-1D scalar Burgers order test (Tools/reference.py sb_q1d).

geom.n_cell        = 128 16 16
geom.Lx            = 6.283185307179586
geom.max_grid_size = 64

prob.problem = scalar_burgers
prob.c       = 1.0 0.0 0.0
prob.nu      = 0.05

ic.type    = modes
ic.active  = 1 0 0
ic.stagger = 1 0 0
ic.mean    = 0.5

time.T        = 1.0
time.dt_max   = 0.02
time.n_levels = 4

ifherk.n_IF   = 0
ifherk.IF_eps = 1.0e-13

out.dir = sb_q1d_run
